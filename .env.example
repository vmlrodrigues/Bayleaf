# Notarisation credentials — same mechanism as ClawBar (App Store Connect API key).
# Scripts/notarize.sh falls back to ../ClawBar/.env automatically, so on this machine
# you don't need this file at all. Copy + fill only on a machine without ClawBar.
NOTARY_KEY="/path/to/AuthKey_XXXXXXXXXX.p8"
NOTARY_KEY_ID="XXXXXXXXXX"
NOTARY_ISSUER="00000000-0000-0000-0000-000000000000"
