<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Bayleaf</string>
	<key>CFBundleDisplayName</key>
	<string>Bayleaf</string>
	<key>CFBundleIdentifier</key>
	<string>com.victorrodrigues.Bayleaf</string>
	<key>CFBundleExecutable</key>
	<string>Bayleaf</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Victor Rodrigues. All rights reserved.</string>
	<!-- Voice asks. Both prompts are worded for the person actually reading them. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Bayleaf listens only while the mic button is on, so you can ask for pages out loud.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your words are turned into text on this Mac — nothing is sent anywhere — to work out which pages you want.</string>
	<!-- Right-click a PDF → Open With → Bayleaf. Alternate rank: never steal the
	     default from Preview. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<!-- Sparkle. SUFeedURL must point at a PUBLICLY readable appcast; the source repo
	     is public, so it hosts the appcast directly (ClawBar pattern). The DMGs are
	     GitHub release assets, not committed files. Changing this after anyone
	     installs orphans them from updates. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/vmlrodrigues/Bayleaf/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>40PuR8W1jlajlGWyyQqt4DbQrVfF0gdkvpimz79tSPA=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
